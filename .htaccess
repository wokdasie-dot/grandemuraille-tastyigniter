# The domain must point at this clone folder. OVH drops the Git link when
# the domain path is set to public/. These rules hide the application tree
# and send every public request into public/.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # First visit over plain HTTP. OVH may terminate TLS and report HTTPS as
    # off while X-Forwarded-Proto or ENV:HTTPS is already https. Redirect only
    # when every one of those says the request is not secure, so the rule
    # cannot loop.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{ENV:HTTPS} !on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # A browser request for /public/... is a second copy of the site.
    # REDIRECT_STATUS is set after the internal rewrite below, so this does not loop.
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^public/?$ / [R=301,L]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^public/(.+)$ /$1 [R=301,L]
    RewriteRule ^public/ - [L]

    RewriteRule "(^|/)\.(?!well-known/)" - [F,L]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 !-f
    RewriteRule ^((?:vendor|app|bootstrap|config|database|extensions|themes|resources|routes|storage|docs|lang|tests|data)(?:/.*)?)$ - [F,L]
    RewriteRule ^(composer\.(json|lock)|artisan|package\.json|webpack\.mix\.js|phpunit\.xml)(/|$) - [F,L]
    RewriteRule \.(env|md|lock|sql|pem|key|bak|log|zip|old)$ - [F,L]
    RewriteRule ~$ - [F,L]

    # The installer is finished. Close it for good. gm-maintain.php stays reachable.
    RewriteRule ^(?:public/)?gm-install\.php$ - [F,L]

    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://www.gravatar.com https://secure.gravatar.com; connect-src 'self'; frame-src 'self' https://challenges.cloudflare.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

Options -Indexes

<Files "gm-install.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</Files>
