# APP CONFIG (DO NOT REMOVE!)
APP_NAME=
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

IGNITER_CARTE_KEY=
IGNITER_LOCATION_MODE=multiple
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# Required on this instance. No default path: do not fall back to another restaurant.
RESTOLINE_PRIVATE_ENV=

# DATABASE CONFIG (DO NOT REMOVE!)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP is filled by the one-time installer and is the mail transport on OVH.
# Leave the host empty here. Do not commit a password.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Optional. Reservation mail uses SMTP when MAIL_HOST is set.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME="${APP_NAME}"
RESTAURANT_NOTIFICATION_EMAIL=
