<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    <IfModule mod_headers.c>
        Header always unset X-Powered-By
    </IfModule>

    # The clone-root rules miss /public/ and /public/index.php when this
    # directory is the one Apache actually enters. Send them to /.
    RewriteCond %{THE_REQUEST} \s/+public/index\.php[\s?] [NC]
    RewriteRule ^ / [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+public/?[\s?] [NC]
    RewriteRule ^ / [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+public/([^\s?]+) [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Trailing slash from the browser request. REQUEST_URI can already
    # contain the internal /public/ folder, which must not be sent back.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{THE_REQUEST} \s/+(.+?)/+\s [NC]
    RewriteRule ^ /%1 [R=301,L]

    RewriteRule \.(bak|log|zip|sql|old)$ - [F,L]
    RewriteRule ~$ - [F,L]

    # The installer is finished. Close it for good. gm-maintain.php stays reachable.
    RewriteRule ^gm-install\.php$ - [F,L]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<Files "gm-install.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</Files>
